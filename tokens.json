{
  "_comment": "ROYAL AMBULANCE COLOR TOKENS v1.0. Machine-readable mirror of snippets/palette.css, for generators that cannot parse CSS: python-pptx, python-docx, matplotlib, reportlab, weasyprint pipelines. Color only. Type values are NOT duplicated here; read snippets/type-tokens.json for the family, weights, scale, leading, tracking and measure.",
  "brand": "royal",
  "brandName": "Royal Ambulance",
  "role": "operating company",
  "parent": "collective-edge",
  "version": "1.0",
  "typeSystemVersion": "1.0",
  "prefix": "royal",
  "cdnRoot": "https://cdn.jsdelivr.net/gh/collective-edge/royal-brand-kit@main/",
  "paletteCss": "https://cdn.jsdelivr.net/gh/collective-edge/royal-brand-kit@main/snippets/palette.css",
  "typeTokensJson": "https://cdn.jsdelivr.net/gh/collective-edge/collective-edge-brand-kit@main/snippets/type-tokens.json",

  "palette": {
    "_comment": "Raw brand palette. CSS name --royal-<key>. Purple is the whole palette.",
    "purple":       { "css": "--royal-purple",       "hex": "#572e72", "rgb": [87, 46, 114],   "use": "workhorse accent. Column headers, accent bars, callout borders, label chips, buttons, links, brand-colored text on white." },
    "darkPurple":   { "css": "--royal-dark-purple",  "hex": "#2f193b", "rgb": [47, 25, 59],    "use": "dominant brand color. Header bands, hero backgrounds, section dividers, table header fill." },
    "lightPurple":  { "css": "--royal-light-purple", "hex": "#8260a2", "rgb": [130, 96, 162],  "use": "tertiary accents and hover only. Never a large background. Never text on white." },
    "royalPurple":  { "css": "--royal-royal-purple", "hex": "#43205b", "rgb": [67, 32, 91],    "use": "logo fill on light. Alternate dark accent. Action or highlight nodes in flowcharts." },
    "black":        { "css": "--royal-black",        "hex": "#000000", "rgb": [0, 0, 0],       "use": "maximum-contrast headings on white." },
    "white":        { "css": "--royal-white",        "hex": "#FFFFFF", "rgb": [255, 255, 255], "use": "page background. Text on any dark purple ground." }
  },

  "neutrals": {
    "charcoal": { "css": "--royal-charcoal", "hex": "#1E293B", "rgb": [30, 41, 59],    "use": "primary body text on light." },
    "muted":    { "css": "--royal-muted",    "hex": "#64748B", "rgb": [100, 116, 139], "use": "secondary and tertiary text, captions, footer left rail, unit labels." },
    "hairline": { "css": "--royal-hairline", "hex": "#E2E8F0", "rgb": [226, 232, 240], "use": "table rules, card borders, footer top border." },
    "surface":  { "css": "--royal-surface",  "hex": "#faf5fd", "rgb": [250, 245, 253], "use": "very light purple tint. Alternating table rows, callout fills." }
  },

  "semantic": {
    "_comment": "Identical NAMES in every brand. A component written for one brand renders correctly in another with only palette.css swapped. Style through this layer. Reach for a raw palette value only where the brand color is the point.",
    "fg1":       { "css": "--fg-1",       "hex": "#1E293B", "use": "primary text on light" },
    "fg2":       { "css": "--fg-2",       "hex": "#64748B", "use": "secondary text" },
    "fg3":       { "css": "--fg-3",       "hex": "#64748B", "use": "tertiary text, metadata, captions, eyebrows" },
    "fg4":       { "css": "--fg-4",       "hex": "#94A3B8", "use": "dimmed labels" },
    "fgAccent":  { "css": "--fg-accent",  "hex": "#572e72", "use": "brand-colored text" },
    "fgOnDark1": { "css": "--fg-on-dark-1", "hex": "#FFFFFF", "use": "primary text on a dark ground" },
    "fgOnDark2": { "css": "--fg-on-dark-2", "hex": "#E0D6E8", "use": "body text on a dark ground" },
    "fgOnDark3": { "css": "--fg-on-dark-3", "hex": "#B0A2BC", "use": "captions and eyebrows on a dark ground" },
    "bgCanvas":   { "css": "--bg-canvas",   "hex": "#FFFFFF", "use": "page background" },
    "bgSurface":  { "css": "--bg-surface",  "hex": "#faf5fd", "use": "tinted surface, alternating rows, callouts" },
    "bgElevated": { "css": "--bg-elevated", "hex": "#FFFFFF", "use": "cards above the surface" },
    "bgInverse":  { "css": "--bg-inverse",  "hex": "#2f193b", "use": "inverted panels and section dividers" },
    "bgBand":     { "css": "--bg-band",     "hex": "#2f193b", "use": "header band, hero band" },
    "border1":       { "css": "--border-1",       "hex": "#E2E8F0", "use": "hairline rules" },
    "border2":       { "css": "--border-2",       "hex": "#CBD5E1", "use": "stronger rules, input borders" },
    "borderOnDark":  { "css": "--border-on-dark", "rgba": "rgba(255,255,255,0.12)", "use": "rules on a dark ground" },
    "borderBandRule":{ "css": "--border-band-rule", "hex": null, "value": "transparent", "use": "Royal has no accent rule under the band. Apex does." }
  },

  "status": {
    "_comment": "Identical in every brand so an operational signal never changes meaning between documents. A brand accent is never a status color.",
    "go":   { "css": "--status-go",   "hex": "#1E7A4D", "use": "cleared, on time, in service" },
    "warn": { "css": "--status-warn", "hex": "#B5821A", "use": "at risk, pending, watch" },
    "stop": { "css": "--status-stop", "hex": "#B0322B", "use": "failed, out of service, blocked" },
    "info": { "css": "--status-info", "hex": "#2A5A8C", "use": "neutral notice" }
  },

  "diagramRoles": {
    "_comment": "Identical in every brand so a diagram reads the same regardless of whose document it sits in. Rectangles, 6px radius. Role is communicated by fill, never by shape. Never invent a new hue for a role.",
    "decision": { "fill": "#4a8e3a", "border": "#3a7029", "css": ["--diagram-decision", "--diagram-decision-border"], "use": "decision boxes, questions, branch points" },
    "warning":  { "fill": "#f57c00", "border": "#cc6600", "css": ["--diagram-warning", "--diagram-warning-border"], "use": "warnings, advisories" },
    "process":  { "fill": "#3e3e3e", "border": "#2a2a2a", "css": ["--diagram-process", "--diagram-process-border"], "use": "neutral process steps, context boxes" },
    "action":   { "fill": "#43205b", "border": "#2f193b", "css": ["--royal-royal-purple", "--royal-dark-purple"], "use": "Royal action or highlight node" },
    "shape":     { "radius": "6px", "rule": "rectangles, 6px radius. Role is communicated by fill color, never by shape." },
    "connector": { "stroke": "#3e3e3e", "width": "1.8pt", "css": "--diagram-connector" }
  },

  "logos": {
    "_comment": "Ask for a ROLE, never a filename. `-on-light` is the version you place ON a light background. `-on-dark` goes ON a dark one.",
    "horizontal-on-light": "https://cdn.jsdelivr.net/gh/collective-edge/royal-brand-kit@main/assets/logos/horizontal-purple.svg",
    "horizontal-on-dark":  "https://cdn.jsdelivr.net/gh/collective-edge/royal-brand-kit@main/assets/logos/horizontal-white.svg",
    "mark-on-light":       "https://cdn.jsdelivr.net/gh/collective-edge/royal-brand-kit@main/assets/logos/crown-purple.svg",
    "mark-on-dark":        "https://cdn.jsdelivr.net/gh/collective-edge/royal-brand-kit@main/assets/logos/crown-white.svg",
    "stacked-on-dark":     "https://cdn.jsdelivr.net/gh/collective-edge/royal-brand-kit@main/assets/logos/stacked-white.svg",
    "stacked-on-light":    "https://cdn.jsdelivr.net/gh/collective-edge/royal-brand-kit@main/assets/logos/stacked-purple.svg"
  },

  "logoSpec": {
    "viewBox": {
      "horizontal": "0 0 735.76 179.54",
      "mark":       "0 0 692.1 692.1",
      "stacked":    "0 0 526.66 418.93"
    },
    "fill": { "onLight": "#43205b", "onDark": "#FFFFFF" },
    "minWidth": { "horizontal": "110px", "mark": "32px" },
    "minWidthPrint": { "horizontal": "1in", "mark": "0.33in" },
    "clearSpace": "padding on all four sides equal to the height of the crown mark",
    "recolor": "never. Pick the file for the ground."
  },

  "radii": { "none": "0", "sm": "2px", "md": "6px", "lg": "12px", "pill": "999px" },
  "shadow": {
    "1": "0 1px 2px rgba(0,0,0,0.06)",
    "2": "0 4px 12px rgba(0,0,0,0.08)",
    "3": "0 12px 32px rgba(0,0,0,0.12)",
    "policy": "The house is flat. Shadow signals elevation, never decoration."
  },
  "motion": {
    "easeStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durFast": "120ms", "durBase": "200ms", "durSlow": "360ms"
  }
}
