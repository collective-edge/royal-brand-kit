{
  "_deprecated": {
    "status": "Deprecated. Superseded by house type system v1.0.",
    "replacedBy": "tokens.json",
    "replacementUrl": "https://cdn.jsdelivr.net/gh/collective-edge/royal-brand-kit@main/tokens.json",
    "authoritativePalette": "snippets/palette.css",
    "why": "This file has no semantic layer, no status colors and no type values, and it names #000000 as body text. Running body text is #1E293B.",
    "kept": "Live documents already point at this URL. Read tokens.json for anything new."
  },

  "brand": {
    "darkPurple":  { "hex": "#2f193b", "rgb": [47, 25, 59],    "role": "Primary headers, hero backgrounds, section dividers" },
    "purple":      { "hex": "#572e72", "rgb": [87, 46, 114],   "role": "Column headers, accent bars, contact labels, category badges" },
    "lightPurple": { "hex": "#8260a2", "rgb": [130, 96, 162],  "role": "Tertiary accents, hover states, lighter highlights" },
    "royalPurple": { "hex": "#43205b", "rgb": [67, 32, 91],    "role": "Logo fill color, alternate dark accent" },
    "black":       { "hex": "#000000", "rgb": [0, 0, 0],       "role": "Body text on white" },
    "white":       { "hex": "#FFFFFF", "rgb": [255, 255, 255], "role": "Text on dark, page background" }
  },
  "neutrals": {
    "charcoal": { "hex": "#1E293B", "role": "Body text on white" },
    "muted":    { "hex": "#64748B", "role": "Supporting text, captions, legends" },
    "hairline": { "hex": "#E2E8F0", "role": "Card borders, thin rules" },
    "surface":  { "hex": "#faf5fd", "role": "Very-light purple background tint" }
  },
  "diagram": {
    "decision":      { "hex": "#4a8e3a", "borderHex": "#3a7029", "role": "Decision boxes, questions, branch points" },
    "warning":       { "hex": "#f57c00", "borderHex": "#cc6600", "role": "Warning boxes, advisories, watch-out pills" },
    "infoProcess":   { "hex": "#3e3e3e", "borderHex": "#2a2a2a", "role": "Neutral process steps, context boxes" }
  },
  "font": {
    "family": "Montserrat",
    "fallback": "Calibri, Arial, sans-serif",
    "cdnUrl": "https://cdn.jsdelivr.net/gh/collective-edge/royal-brand-kit@main/assets/fonts/Montserrat-VariableFont_wght.ttf"
  }
}
